<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - My App</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    @* Check if Styles section is defined, and render it if present *@
    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }

    <style>
        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-form {
            max-width: 420px;
            margin: 80px auto;
            background: #fff;
            padding: 30px 40px;
            border-radius: 8px;
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.08);
        }

            .register-form h2 {
                text-align: center;
                margin-bottom: 25px;
                color: #2e7d32;
            }

        .form-control {
            border-radius: 6px;
        }

        .btn-register {
            background-color: #2e7d32;
            border: none;
        }

            .btn-register:hover {
                background-color: #256029;
            }
    </style>
</head>
<body>
    @RenderBody()

    @* Check if Scripts section is defined, and render it if present *@
    @if (IsSectionDefined("Scripts"))
    {
        @RenderSection("Scripts", required: false)
    }
</body>
</html>
