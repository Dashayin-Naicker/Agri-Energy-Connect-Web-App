@model ST10378422_PROG7311_POE.Models.RegisterViewModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    bool isLoggedIn = SignInManager.IsSignedIn(User);
    bool isEmployee = User.IsInRole("Employee");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-white text-center">
                    <h2 class="text-success mb-0">Create an Account</h2>
                </div>
                <div class="card-body">

                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label">Full Name</label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Create a password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Role -->
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Role</label>
                            <select asp-for="Role" class="form-control" onchange="toggleRoleFields()">
                                <option value="">-- Select Role --</option>
                                <option value="Farmer">Farmer</option>
                                @if (isLoggedIn && isEmployee)
                                {
                                    <option value="Employee">Employee</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <!-- Farm Location (Farmer) -->
                        <div class="mb-3" id="farmLocationField" style="display:none;">
                            <label asp-for="FarmLocation" class="form-label">Farm Location</label>
                            <input asp-for="FarmLocation" class="form-control" placeholder="Enter farm location" />
                            <span asp-validation-for="FarmLocation" class="text-danger"></span>
                        </div>

                        <!-- Department (Employee) -->
                        <div class="mb-3" id="departmentField" style="display:none;">
                            <label asp-for="Department" class="form-label">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="Enter department name" />
                            <span asp-validation-for="Department" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Register</button>
                    </form>

                    <div class="mt-4 text-center">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">
                            ← Back to Home
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-header h2 {
            color: #28a745;
        }

        .btn-success {
            background-color: #28a745;
            border: none;
        }

            .btn-success:hover {
                background-color: #218838;
            }

        .form-label {
            font-weight: 500;
        }
    </style>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function toggleRoleFields() {
            const role = document.querySelector('select[name="Role"]').value;
            const farmField = document.getElementById('farmLocationField');
            const deptField = document.getElementById('departmentField');

            farmField.style.display = (role === "Farmer") ? 'block' : 'none';
            deptField.style.display = (role === "Employee") ? 'block' : 'none';

            if (role !== "Farmer") farmField.querySelector('input').value = '';
            if (role !== "Employee") deptField.querySelector('input').value = '';
        }

        document.addEventListener("DOMContentLoaded", toggleRoleFields);
    </script>
}
