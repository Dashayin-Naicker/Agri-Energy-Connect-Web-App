@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="login-form container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-white text-center">
            <h2 class="text-success mb-0">Login</h2>
        </div>
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100">Login</button>
            </form>

            <div class="mt-3 text-center">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-success">
                    ← Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .login-form {
            max-width: 500px;
            margin: 0 auto;
        }

        .card-header h2 {
            color: #28a745;
        }

        .btn-success {
            background-color: #28a745;
            border: none;
        }

            .btn-success:hover {
                background-color: #218838;
            }
    </style>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
