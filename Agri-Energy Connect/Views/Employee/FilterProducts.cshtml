@model IEnumerable<ST10378422_PROG7311_POE.Models.Product>
@{
    ViewBag.Title = "Filter Products";
    Layout = "~/Views/Shared/_NavLayout.cshtml";

    // Prepare list of farmers for dropdown
    ViewBag.Farmers = new SelectList(Model.Select(p => p.Farmer).Distinct(), "FarmerId", "FullName");

    // Capture query parameters (using HttpContext)
    var farmerId = Context.Request.Query["farmerId"];
    var category = Context.Request.Query["category"];
    var startDate = Context.Request.Query["startDate"];
    var endDate = Context.Request.Query["endDate"];
}

<div class="container mt-4">
    <h2 class="text-center text-success">Filter Products</h2>
    <p class="text-center text-muted">Here you can filter products by farmer and/or category within a date range.</p>

    <form method="get" class="form-inline">
        <div class="row mb-3">
            <!-- Farmer Selection -->
            <div class="col-md-3">
                <label class="form-label">Farmer</label>
                @Html.DropDownList("farmerId", ViewBag.Farmers as SelectList, "-- All Farmers --", new { @class = "form-select" })
            </div>

            <!-- Category Selection -->
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <input type="text" name="category" class="form-control" placeholder="Category" value="@category" />
            </div>

            <!-- Date Range Selection -->
            <div class="col-md-3">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" class="form-control" value="@startDate" />
            </div>

            <div class="col-md-3">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" class="form-control" value="@endDate" />
            </div>

            <!-- Submit Button -->
            <div class="col-md-12 mt-3">
                <button type="submit" class="btn btn-success">Filter</button>
            </div>
        </div>
    </form>

    <h4 class="mt-4">Product List</h4>
    @if (Model.Any())
    {
        <table class="table table-striped table-bordered mt-4">
            <thead>
                <tr>
                    <th scope="col">Product Name</th>
                    <th scope="col">Farmer</th>
                    <th scope="col">Category</th>
                    <th scope="col">Production Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Farmer.FullName</td>
                        <td>@product.Category</td>
                        <td>@product.ProductionDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-center text-warning">No products found for the selected filters.</p>
    }
</div>
