@model IEnumerable<ST10378422_PROG7311_POE.Models.Farmer>

@{
    ViewData["Title"] = "View Farmers";
    Layout = "~/Views/Shared/_NavLayout.cshtml";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="text-center mt-4 mb-3">
            <h2 class="text-success">Registered Farmers</h2>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-success">
                            <tr>
                                <th scope="col">Farmer ID</th>
                                <th scope="col">Full Name</th>
                                <th scope="col">Farm Location</th>
                                <th scope="col">User ID</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var farmer in Model)
                            {
                                <tr>
                                    <td>@farmer.FarmerId</td>
                                    <td>@farmer.FullName</td>
                                    <td>@farmer.FarmLocation</td>
                                    <td>@farmer.UserId</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center" role="alert">
                    No farmers found.
                </div>
            }
        </div>
        <div class="card-footer text-end">
            <a class="btn btn-outline-success" asp-controller="Account" asp-action="Register">Add New Farmer</a>
        </div>
    </div>
</div>
